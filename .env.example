# Template for the OpenClaw secret set.
# Copy to config/.env on the deploy host (NOT committed, gitignored).
#   cp .env.example config/.env
#
# The real secret file lives at /opt/apps/openclaw/config/.env on .149
# and is injected via docker-compose env_file + copied by entrypoint.sh.

DEEPSEEK_API_KEY=
# OpenRouter (LLM-Provider; primary-Modell laeuft ueber OpenRouter)
OPENROUTER_API_KEY=
KAGI_API=
TELEGRAM_BOT_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
GH_TOKEN=
# ── GitHub Apps: momo-clanker (coder/Runner A) + momo-claw (reviewer/Runner B) ──
# Zwei getrennte Bot-Identities für die A/B-Runner. Config liegt NICHT in config/.env,
# sondern je App in ~/.config/gh-bots/<app>.env auf .149 (Keys: GH_APP_ID,
# GH_APP_INSTALLATION_ID, GH_APP_PRIVATE_KEY_FILE). Private Keys: /home/momo/.secrets/
# {momo-clanker,momo-claw}.pem (chmod 600). Details: docs/github-bot-identity-split.md.
# Solange keine App konfiguriert ist, läuft alles weiter über GH_TOKEN (PAT) oben.
#
# Template je App (~/.config/gh-bots/momo-clanker.env bzw. momo-claw.env):
#   GH_APP_ID=
#   GH_APP_INSTALLATION_ID=
#   GH_APP_PRIVATE_KEY_FILE=/home/momo/.secrets/momo-clanker.pem
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Deploy webhook shared secret (matches GitHub repo secret DEPLOY_TOKEN)
DEPLOY_TOKEN=
# Infra access (Hetzner / Contabo / Cloudflare) — real values go into
# config/.env on .149 (gitignored, injected via docker-compose env_file + entrypoint.sh).
# Hetzner Cloud API — ein Token pro Projekt (die API ist projektbezogen, ein Token
# sieht nur sein eigenes Projekt). Server laufen im Projekt mittelerde. Die
# StorageBoxes sind ins Cloud-Projekt 11031986 migriert und laufen ueber die Cloud
# API (https://api.hetzner.com/v1/storage_boxes, Bearer-Token) - kein Robot-Zugang
# mehr noetig.
HETZNER_API_TOKEN_MITTELERDE=
HETZNER_API_TOKEN_STORAGEBOXES=
# Contabo Cloud API v2, OAuth2 password grant
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
# Contabo API User = CCP-Email; API Password = separates Passwort aus
# my.contabo.com/api/details (NICHT das CCP-Login-Passwort).
CONTABO_API_USER=
CONTABO_API_PASSWORD=
# Cloudflare API
CLOUDFLARE_API_TOKEN=
