# Template for the OpenClaw secret set.
# Copy to config/.env on the deploy host (NOT committed, gitignored).
#   cp .env.example config/.env
#
# The real secret file lives at /opt/apps/openclaw/config/.env on .149
# and is injected via docker-compose env_file + copied by entrypoint.sh.

DEEPSEEK_API_KEY=
KAGI_API=
TELEGRAM_BOT_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
GH_TOKEN=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Deploy webhook shared secret (matches GitHub repo secret DEPLOY_TOKEN)
DEPLOY_TOKEN=
# Infra access (Hetzner / Contabo / Cloudflare / INWX) — real values go into
# config/.env on .149 (gitignored, injected via docker-compose env_file + entrypoint.sh).
# Hetzner Cloud API — ein Token pro Projekt (die API ist projektbezogen, ein Token
# sieht nur sein eigenes Projekt). Server laufen im Projekt mittelerde; das Projekt
# StorageBoxes ist in der Cloud-API derzeit leer (0 Server/Volumes).
HETZNER_API_TOKEN_MITTELERDE=
HETZNER_API_TOKEN_STORAGEBOXES=
# Hetzner Robot API (StorageBoxes!) — NICHT die Cloud-API: StorageBoxes laufen ueber
# https://robot-ws.your-server.de mit HTTP Basic Auth (Webservice-User + Passwort aus
# dem Robot-Panel: Einstellungen -> Webservice & App-Einstellungen). Der Cloud-Token
# kann sie NICHT abrufen (/storage_boxes existiert nicht, HTTP 404).
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=
# Contabo Cloud API v2, OAuth2
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
# Cloudflare API
CLOUDFLARE_API_TOKEN=
# INWX (Domain-Registrar, DomRobot) — Auth mit Benutzer + Passwort (kein API-Token)
INWX_API_USER=
INWX_API_PASSWORD=
