{
  "gateway": {
    "bind": "lan",
    "mode": "local",
    "trustedProxies": ["172.17.0.1"],
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": false
    },
    "controlUi": {
      "allowedOrigins": ["https://openclaw.simonklimke.de"]
    }
  },
  "env": {
    "vars": {
      "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
      "KAGI_API": "${KAGI_API}",
      "GROQ_API_KEY": "${GROQ_API_KEY}",
      "DEEPGRAM_API_KEY": "${DEEPGRAM_API_KEY}",
      "GH_TOKEN": "${GH_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-pro"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "allowAgents": [
          "coding-orchestrator",
          "feature-dev-planner",
          "feature-dev-setup",
          "feature-dev-developer",
          "feature-dev-verifier",
          "feature-dev-tester",
          "feature-dev-reviewer"
        ]
      }
    },
    "list": [
      {
        "id": "main",
        "workspace": "/home/node/.openclaw/workspace",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "coding-orchestrator",
        "workspace": "/home/node/.openclaw/workspaces/coding-orchestrator",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-planner",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-planner",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-setup",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-setup",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-developer",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-developer",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-verifier",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-verifier",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-tester",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-tester",
        "model": "deepseek/deepseek-v4-pro"
      },
      {
        "id": "feature-dev-reviewer",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-reviewer",
        "model": "deepseek/deepseek-v4-pro"
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "messages": {
    "groupChat": {
      "mentionPatterns": ["@molty", "@openclaw"]
    }
  },
  "tools": {
    "media": {
      "models": [
        {
          "provider": "groq",
          "model": "whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "provider": "deepgram",
          "model": "nova-3",
          "language": "de",
          "capabilities": ["audio"]
        },
        {
          "provider": "google",
          "model": "gemini-3-flash-preview",
          "capabilities": ["image"]
        }
      ],
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "🎙️ {transcript}"
      },
      "image": {
        "enabled": true
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-08-11T21:58:40.365Z"
  }
}
