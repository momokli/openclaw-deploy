{
  "gateway": {
    "bind": "lan",
    "mode": "local",
    "trustedProxies": ["172.23.0.0/16"],
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": false
    },
    "controlUi": {
      "allowedOrigins": ["https://openclaw.simonklimke.de"]
    }
  },
  "env": {
    "vars": {
      "KAGI_API": "${KAGI_API}",
      "GH_TOKEN": "${GH_TOKEN}",
      "HETZNER_API_TOKEN_STORAGEBOXES": "${HETZNER_API_TOKEN_STORAGEBOXES}",
      "HETZNER_API_TOKEN_MITTELERDE": "${HETZNER_API_TOKEN_MITTELERDE}",
      "CONTABO_CLIENT_ID": "${CONTABO_CLIENT_ID}",
      "CONTABO_CLIENT_SECRET": "${CONTABO_CLIENT_SECRET}",
      "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
      "INWX_API_USER": "${INWX_API_USER}",
      "INWX_API_PASSWORD": "${INWX_API_PASSWORD}",
      "HETZNER_ROBOT_USER": "${HETZNER_ROBOT_USER}",
      "HETZNER_ROBOT_PASSWORD": "${HETZNER_ROBOT_PASSWORD}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": ["deepseek/deepseek-v4-pro"]
      },
      "compaction": {
        "model": "deepseek/deepseek-v4-flash"
      },
      "utilityModel": "deepseek/deepseek-v4-flash",
      "contextPruning": {
        "mode": "cache-ttl"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "model": "deepseek/deepseek-v4-flash",
        "allowAgents": [
          "coding-orchestrator",
          "feature-dev-planner",
          "feature-dev-setup",
          "feature-dev-developer",
          "feature-dev-verifier",
          "feature-dev-tester",
          "feature-dev-reviewer"
        ]
      },
      "memorySearch": {
        "provider": "gemini",
        "model": "gemini-embedding-001",
        "extraPaths": ["/quill"]
      }
    },
    "list": [
      {
        "id": "main",
        "workspace": "/home/node/.openclaw/workspace",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "coding-orchestrator",
        "workspace": "/home/node/.openclaw/workspaces/coding-orchestrator",
        "model": "deepseek/deepseek-v4-pro",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-planner",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-planner",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-setup",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-setup",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-developer",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-developer",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-verifier",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-verifier",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-tester",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-tester",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      {
        "id": "feature-dev-reviewer",
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-reviewer",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "streaming": {
        "mode": "partial",
        "preview": {
          "toolProgress": false
        }
      },
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "messages": {
    "responseUsage": "tokens",
    "groupChat": {
      "mentionPatterns": ["@molty", "@openclaw"]
    }
  },
  "tools": {
    "media": {
      "models": [
        {
          "provider": "groq",
          "model": "whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "provider": "deepgram",
          "model": "nova-3",
          "language": "de",
          "capabilities": ["audio"]
        },
        {
          "provider": "google",
          "model": "gemini-3-flash-preview",
          "capabilities": ["image"]
        }
      ],
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "🎙️ {transcript}"
      },
      "image": {
        "enabled": true
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 120
    },
    "maintenance": {
      "maxEntries": 300,
      "pruneAfter": "14d"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-08-11T21:58:40.365Z"
  }
}
