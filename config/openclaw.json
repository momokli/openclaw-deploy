{
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-flash",
            "name": "DeepSeek Flash",
            "api": "openai-completions",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "cost": {
              "input": 0.15,
              "output": 0.6,
              "cacheRead": 0.003,
              "cacheWrite": 0
            },
            "compat": {
              "supportsUsageInStreaming": true,
              "supportsReasoningEffort": true,
              "maxTokensField": "max_tokens",
              "codeMode": "preferred"
            }
          }
        ]
      }
    }
  },
  "gateway": {
    "bind": "lan",
    "mode": "local",
    "remote": {
      "url": "https://openclaw.simonklimke.de"
    },
    "trustedProxies": ["172.23.0.0/16"],
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": false
    },
    "controlUi": {
      "allowedOrigins": ["https://openclaw.simonklimke.de"]
    }
  },
  "env": {
    "vars": {
      "KAGI_API": "${KAGI_API}",
      "GH_TOKEN": "${GH_TOKEN}",
      "GH_APP_ID": "${GH_APP_ID}",
      "GH_APP_INSTALLATION_ID": "${GH_APP_INSTALLATION_ID}",
      "GH_APP_PRIVATE_KEY_FILE": "${GH_APP_PRIVATE_KEY_FILE}",
      "HETZNER_API_TOKEN_STORAGEBOXES": "${HETZNER_API_TOKEN_STORAGEBOXES}",
      "HETZNER_API_TOKEN_MITTELERDE": "${HETZNER_API_TOKEN_MITTELERDE}",
      "CONTABO_CLIENT_ID": "${CONTABO_CLIENT_ID}",
      "CONTABO_CLIENT_SECRET": "${CONTABO_CLIENT_SECRET}",
      "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
      "INWX_API_USER": "${INWX_API_USER}",
      "INWX_API_PASSWORD": "${INWX_API_PASSWORD}"
    }
  },
  "memory": {
    "search": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "remote": {
        "baseUrl": "http://ollama:11434",
        "apiKey": "ollama-local"
      },
      "fallback": "none",
      "extraPaths": ["/quill"]
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "/home/momo/.openclaw/workspace",
      "model": {
        "primary": "openrouter/deepseek/deepseek-v4.1-flash",
        "fallbacks": ["openrouter/deepseek/deepseek-v4-pro"]
      },
      "compaction": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "maxActiveTranscriptBytes": "2mb",
        "midTurnPrecheck": {
          "enabled": true
        }
      },
      "utilityModel": "openrouter/deepseek/deepseek-v4.1-flash",
      "systemAgent": {
        "agentId": "main"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "allowAgents": [
          "coding-orchestrator",
          "thinking-orchestrator",
          "planning-orchestrator",
          "operator",
          "feature-dev-planner",
          "feature-dev-setup",
          "feature-dev-developer",
          "feature-dev-verifier",
          "feature-dev-tester",
          "feature-dev-reviewer",
          "plan-builder",
          "critic",
          "researcher",
          "web-researcher"
        ]
      }
    },
    "entries": {
      "main": {
        "workspace": "/home/momo/.openclaw/workspace",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "coding-orchestrator": {
        "workspace": "/home/momo/.openclaw/workspaces/coding-orchestrator",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "thinking-orchestrator": {
        "workspace": "/home/momo/.openclaw/workspaces/thinking-orchestrator",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "max"
      },
      "planning-orchestrator": {
        "workspace": "/home/momo/.openclaw/workspaces/planning-orchestrator",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "max"
      },
      "operator": {
        "workspace": "/home/momo/.openclaw/workspaces/operator",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-planner": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-planner",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-setup": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-setup",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-developer": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-developer",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-verifier": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-verifier",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-tester": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-tester",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-reviewer": {
        "workspace": "/home/momo/.openclaw/workspaces/feature-dev-reviewer",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "plan-builder": {
        "workspace": "/home/momo/.openclaw/workspaces/plan-builder",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "max"
      },
      "critic": {
        "workspace": "/home/momo/.openclaw/workspaces/critic",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "max"
      },
      "researcher": {
        "workspace": "/home/momo/.openclaw/workspaces/researcher",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      },
      "web-researcher": {
        "workspace": "/home/momo/.openclaw/workspaces/web-researcher",
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingDefault": "low"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "streaming": {
        "mode": "partial",
        "preview": {
          "toolProgress": false
        }
      },
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "bindings": [
    {
      "type": "route",
      "agentId": "main",
      "match": {
        "channel": "telegram"
      }
    }
  ],
  "messages": {
    "responseUsage": "tokens",
    "queue": {
      "mode": "interrupt",
      "byChannel": {
        "telegram": "interrupt"
      }
    },
    "groupChat": {
      "mentionPatterns": ["@molty", "@openclaw"]
    }
  },
  "skills": {
    "entries": {
      "gh-issues": {
        "apiKey": "${GH_TOKEN}"
      }
    }
  },
  "tools": {
    "media": {
      "models": [
        {
          "provider": "groq",
          "model": "whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "provider": "deepgram",
          "model": "nova-3",
          "language": "de",
          "capabilities": ["audio"]
        },
        {
          "provider": "google",
          "model": "gemini-3.6-flash",
          "capabilities": ["image"]
        }
      ],
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "🎙️ {transcript}"
      },
      "image": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    },
    "exec": {
      "node": "planet"
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 120
    },
    "maintenance": {
      "maxEntries": 300,
      "pruneAfter": "14d"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.8.1"
  }
}
