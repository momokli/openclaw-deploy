{
  "gateway": {
    "bind": "lan",
    "mode": "local",
    "trustedProxies": ["172.23.0.0/16"],
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": false
    },
    "controlUi": {
      "allowedOrigins": ["https://openclaw.simonklimke.de"]
    }
  },
  "env": {
    "vars": {
      "KAGI_API": "${KAGI_API}",
      "GH_TOKEN": "${GH_TOKEN}",
      "GH_APP_ID": "${GH_APP_ID}",
      "GH_APP_INSTALLATION_ID": "${GH_APP_INSTALLATION_ID}",
      "GH_APP_PRIVATE_KEY_FILE": "${GH_APP_PRIVATE_KEY_FILE}",
      "HETZNER_API_TOKEN_STORAGEBOXES": "${HETZNER_API_TOKEN_STORAGEBOXES}",
      "HETZNER_API_TOKEN_MITTELERDE": "${HETZNER_API_TOKEN_MITTELERDE}",
      "CONTABO_CLIENT_ID": "${CONTABO_CLIENT_ID}",
      "CONTABO_CLIENT_SECRET": "${CONTABO_CLIENT_SECRET}",
      "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
      "INWX_API_USER": "${INWX_API_USER}",
      "INWX_API_PASSWORD": "${INWX_API_PASSWORD}",
      "HETZNER_ROBOT_USER": "${HETZNER_ROBOT_USER}",
      "HETZNER_ROBOT_PASSWORD": "${HETZNER_ROBOT_PASSWORD}"
    }
  },
  "memory": {
    "search": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "remote": {
        "baseUrl": "http://ollama:11434",
        "apiKey": "ollama-local"
      },
      "fallback": "none",
      "extraPaths": ["/quill"]
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": ["deepseek/deepseek-v4-pro"]
      },
      "compaction": {
        "model": "deepseek/deepseek-v4-flash",
        "maxActiveTranscriptBytes": "2mb",
        "midTurnPrecheck": {
          "enabled": true
        }
      },
      "utilityModel": "deepseek/deepseek-v4-flash",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "model": "deepseek/deepseek-v4-flash",
        "allowAgents": [
          "coding-orchestrator",
          "thinking-orchestrator",
          "operator",
          "feature-dev-planner",
          "feature-dev-setup",
          "feature-dev-developer",
          "feature-dev-verifier",
          "feature-dev-tester",
          "feature-dev-reviewer"
        ]
      }
    },
    "entries": {
      "main": {
        "workspace": "/home/node/.openclaw/workspace",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "coding-orchestrator": {
        "workspace": "/home/node/.openclaw/workspaces/coding-orchestrator",
        "model": "deepseek/deepseek-v4-pro",
        "thinkingDefault": "low"
      },
      "thinking-orchestrator": {
        "workspace": "/home/node/.openclaw/workspaces/thinking-orchestrator",
        "model": "deepseek/deepseek-v4-pro",
        "thinkingDefault": "high"
      },
      "operator": {
        "workspace": "/home/node/.openclaw/workspaces/operator",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-planner": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-planner",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-setup": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-setup",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-developer": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-developer",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-verifier": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-verifier",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-tester": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-tester",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      },
      "feature-dev-reviewer": {
        "workspace": "/home/node/.openclaw/workspaces/feature-dev-reviewer",
        "model": "deepseek/deepseek-v4-flash",
        "thinkingDefault": "low"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "streaming": {
        "mode": "partial",
        "preview": {
          "toolProgress": false
        }
      },
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "messages": {
    "responseUsage": "tokens",
    "queue": {
      "mode": "interrupt",
      "byChannel": {
        "telegram": "interrupt"
      }
    },
    "groupChat": {
      "mentionPatterns": ["@molty", "@openclaw"]
    }
  },
  "skills": {
    "entries": {
      "gh-issues": {
        "apiKey": "${GH_TOKEN}"
      }
    }
  },
  "tools": {
    "media": {
      "models": [
        {
          "provider": "groq",
          "model": "whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "provider": "deepgram",
          "model": "nova-3",
          "language": "de",
          "capabilities": ["audio"]
        },
        {
          "provider": "google",
          "model": "gemini-3-flash-preview",
          "capabilities": ["image"]
        }
      ],
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "🎙️ {transcript}"
      },
      "image": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 120
    },
    "maintenance": {
      "maxEntries": 300,
      "pruneAfter": "14d"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.8.1"
  }
}
