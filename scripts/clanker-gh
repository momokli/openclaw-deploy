#!/bin/bash
# clanker-gh — run `gh` as momo-clanker[bot]; falls back to the default identity
# until the app is configured (~/.config/gh-bots/momo-clanker.env present).
set -euo pipefail
APP="momo-clanker"
if gh-bot-auth.sh --app "$APP" >/dev/null 2>&1; then
  export GH_CONFIG_DIR="$HOME/.config/gh-$APP"
else
  echo "clanker-gh: $APP not configured — falling back to default gh" >&2
fi
exec gh "$@"
