#!/bin/bash
# clanker-git — run `git` as clanker[bot]; falls back to default identity until the app
# is configured (~/.config/gh-bots/clanker.env present).
set -euo pipefail
if gh-bot-auth.sh --app clanker >/dev/null 2>&1; then
  export GH_CONFIG_DIR="$HOME/.config/gh-clanker"
  BOT_ID="$(gh-bot-auth.sh --app clanker --bot-id 2>/dev/null || true)"
  if [ -n "$BOT_ID" ] && [ "$BOT_ID" != "null" ]; then
    export GIT_AUTHOR_NAME="clanker[bot]"
    export GIT_AUTHOR_EMAIL="${BOT_ID}+clanker[bot]@users.noreply.github.com"
    export GIT_COMMITTER_NAME="clanker[bot]"
    export GIT_COMMITTER_EMAIL="${BOT_ID}+clanker[bot]@users.noreply.github.com"
  else
    echo "clanker-git: WARN could not resolve clanker[bot] user id" >&2
  fi
else
  echo "clanker-git: clanker not configured — falling back to default git" >&2
fi
exec git "$@"
