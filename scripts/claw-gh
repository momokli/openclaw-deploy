#!/bin/bash
# claw-gh — run `gh` as claw[bot]; falls back to the default identity until the app is
# configured (~/.config/gh-bots/claw.env present).
set -euo pipefail
if gh-bot-auth.sh --app claw >/dev/null 2>&1; then
  export GH_CONFIG_DIR="$HOME/.config/gh-claw"
else
  echo "claw-gh: claw not configured — falling back to default gh" >&2
fi
exec gh "$@"
